# LedgerLens Backend — Environment Variables
#
# This file is safe to commit. It contains NO real credentials.
# Copy this file to backend/.env and replace all CHANGE_ME values.
#
#   cp backend/.env.example backend/.env
#
# NEVER commit backend/.env to git.

# Application
APP_NAME=LedgerLens
DEBUG=false
API_VERSION=v1

# PostgreSQL connection URL.
# Must match the POSTGRES_PASSWORD set in root .env (used by docker-compose).
# Replace CHANGE_ME with the same password you set in root .env.
DATABASE_URL=postgresql://ledgerlens:CHANGE_ME@localhost:5432/ledgerlens
