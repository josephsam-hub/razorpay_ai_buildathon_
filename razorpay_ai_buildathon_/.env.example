# LedgerLens — Root Environment Variables
#
# This file is safe to commit. It contains NO real credentials.
# Copy this file to .env and replace all CHANGE_ME values before running.
#
#   cp .env.example .env
#
# NEVER commit .env to git.

# PostgreSQL password used by docker-compose.
# Must match the password in backend/.env DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
